{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "maxLength": 40
    },
    "avatarId": {
      "type": "string",
      "const": "deepblue-chibi-v1"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "motions": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "groups": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "avatarId",
    "description",
    "motions",
    "groups"
  ],
  "additionalProperties": false
}