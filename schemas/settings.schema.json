{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "size": {
      "type": "number",
      "minimum": 0.6,
      "maximum": 1.5
    },
    "alwaysOnTop": {
      "type": "boolean"
    },
    "fixedPosition": {
      "type": "boolean"
    },
    "roaming": {
      "type": "boolean"
    },
    "intervalMinMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000
    },
    "intervalMaxMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000
    },
    "bubbles": {
      "type": "boolean"
    },
    "autonomousBubbles": {
      "type": "boolean"
    },
    "clickThrough": {
      "type": "boolean"
    },
    "fps": {
      "anyOf": [
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "paused": {
      "type": "boolean"
    },
    "position": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "headAction": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]{1,80}:[a-zA-Z0-9_.-]{1,80}$"
    },
    "bodyAction": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]{1,80}:[a-zA-Z0-9_.-]{1,80}$"
    },
    "overrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_.-]{1,80}:[a-zA-Z0-9_.-]{1,80}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "eligible": {
            "type": "boolean"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "cooldownMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "size",
    "alwaysOnTop",
    "fixedPosition",
    "roaming",
    "intervalMinMs",
    "intervalMaxMs",
    "bubbles",
    "autonomousBubbles",
    "clickThrough",
    "fps",
    "paused",
    "position",
    "headAction",
    "bodyAction",
    "overrides"
  ],
  "additionalProperties": false
}