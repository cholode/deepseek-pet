{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,78}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "author": {
      "default": "",
      "type": "string",
      "maxLength": 120
    },
    "transport": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stdio"
            },
            "runtime": {
              "type": "string",
              "enum": [
                "executable",
                "node",
                "python"
              ]
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "args": {
              "default": [],
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2000
              }
            }
          },
          "required": [
            "type",
            "runtime",
            "entry",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "streamable-http"
            },
            "defaultUrl": {
              "default": "",
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "type",
            "defaultUrl"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "transport"
  ],
  "additionalProperties": false
}