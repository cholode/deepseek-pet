{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "updated": {
      "type": "string",
      "maxLength": 80
    },
    "items": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pack": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{12}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 14,
            "maximum": 8388608
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "emotion": {
            "type": "string",
            "maxLength": 80
          },
          "tags": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "use": {
            "type": "string",
            "maxLength": 1000
          },
          "direction": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "meme": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "pack",
          "name",
          "hash",
          "bytes",
          "width",
          "height",
          "frames",
          "url",
          "emotion",
          "tags",
          "description",
          "use",
          "direction",
          "text",
          "meme"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "updated",
    "items"
  ],
  "additionalProperties": false
}