{
  "name": "deepblue-desktop-pet",
  "version": "1.1.0",
  "description": "离线、数据驱动的蓝发桌宠",
  "author": "DeepBlue contributors",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "schemas": "tsx scripts/schemas.ts",
    "assets": "tsx scripts/art-assets.ts",
    "test:gui": "node scripts/gui-test.cjs"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.2",
    "playwright": "^1.58.0",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "local.deepblue.pet",
    "productName": "DeepBlue Desktop Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "pet-resources"
      },
      {
        "from": "examples/custom-action-pack",
        "to": "examples/custom-action-pack"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "resources/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "DeepBlue-Desktop-Pet-${version}-win-x64.exe"
    }
  }
}
